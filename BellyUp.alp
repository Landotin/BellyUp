					<Id>1774261508189</Id>
					<Name><![CDATA[foodSelectionWaiting]]></Name>
					<X>1050</X><Y>1030</Y>
					<Label><X>-15</X><Y>-25</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.pedestrian]]></PackageName>
						<ClassName><![CDATA[PedWait]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.pedestrian]]></PackageName>
							<ClassName><![CDATA[PedWait]]></ClassName>
							<ItemName><![CDATA[1412464601107]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[locationType]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[locationNode]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[walkStation]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[attractorChoice]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[attractor]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[locationLine]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[targetLine1]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[locationX]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[locationY]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayType]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTimeout]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[triangular(0.5, 1.0, 1.5) + (totalStationSkips * 0.0125) ]]></Code>
								<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[waitForGroup]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayStartsWhen]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[targetReachTolerance]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onBeginWait]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[double r = uniform(0, 1);
int firstChoice;
if (r < 0.40)      firstChoice = 0;  // Seafood: 40%
else if (r < 0.65) firstChoice = 1;  // Dimsum: 25%
else if (r < 0.85) firstChoice = 2;  // Buffet: 20%
else               firstChoice = 3;  // Beverage: 15%

// Skip empty stations ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â cascade to next available
double[] levels = { seaFoodLevel, dimsumFoodLevel, buffetFoodLevel, beverageFoodLevel };
if (levels[firstChoice] > 0) {
    ped.foodChoice = firstChoice;
} else {
    boolean found = false;
    for (int i = 0; i < 4; i++) {
        if (i != firstChoice && levels[i] > 0) {
            ped.foodChoice = i; totalStationSkips++; found = true;
            break;
        }
    }
    if (!found) ped.foodChoice = firstChoice; // all empty, take original
}
]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (ped.foodChoice == 0) seaFoodLevel = Math.max(0, (int)seaFoodLevel - 1);
else if (ped.foodChoice == 1) dimsumFoodLevel = Math.max(0, dimsumFoodLevel - 1);
else if (ped.foodChoice == 2) buffetFoodLevel = Math.max(0, buffetFoodLevel - 1);
else if (ped.foodChoice == 3) beverageFoodLevel = Math.max(0, beverageFoodLevel - 1);

// Independent checks — not else-if chains
// Threshold is 30% of max for each station
if (seaFoodLevel <= (seaFoodMax * 0.30) && !seaFoodRefilling) {
    seaFoodRefilling = true;
    refillStationIndex = 0;
    triggerRefill.inject(1);
}
if (dimsumFoodLevel <= (dimsumFoodMax * 0.30) && !dimsumRefilling) {
    dimsumRefilling = true;
    refillStationIndex = 1;
    triggerRefill.inject(1);
}
if (buffetFoodLevel <= (buffetFoodMax * 0.30) && !buffetRefilling) {
    buffetRefilling = true;
    refillStationIndex = 2;
    triggerRefill.inject(1);
}
if (beverageFoodLevel <= (beverageFoodMax * 0.30) && !beverageRefilling) {
    beverageRefilling = true;
    refillStationIndex = 3;
    triggerRefill.inject(1);
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onCancel]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onRemove]]></Name>
						</Parameter>
					</Parameters>
