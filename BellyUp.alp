					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (ped.assignedTable != null) {
    // Only add it if it's NOT already in the dirty list
    if (!dirtyTables.contains(ped.assignedTable)) {
        dirtyTables.add(ped.assignedTable);
        
        // Only inject a cleaning task once per table!
        busboyCleaning.inject(1);
    }
    

}
]]></Code>
							</Value>
						</Parameter>
