				<Event>
					<Id>1775900100001</Id>
					<Name><![CDATA[balkingTimer]]></Name>
					<X>2010</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1775900100000</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1774684800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// --- Group Balking Timer: every 1 minute ---
// Check lobby4 (groups of 1-4) for overdue leaders
for (Object obj : new java.util.ArrayList<>(lobby4.getPeds())) {
    Customer c = (Customer) obj;
    // Only process group leaders and solo customers (not group members)
    if (c.getGroup() == null || c.getGroup().getLeader() == c) {
        if (c.entryTime >= 0 && (time(MINUTE) - c.entryTime) > c.balkingThreshold) {
            balkCount++;
            // Cancel entire group - routes through ccl port -> balkSink1
            if (c.getGroup() != null) {
                java.util.ArrayList<Agent> members = new java.util.ArrayList<>();
                for (Agent a : c.getGroup()) members.add(a);
                for (Agent a : members) {
                    Customer member = (Customer) a;
                    if (lobby4.contains(member)) {
                        lobby4.cancel(member);
                    }
                }
            } else {
                if (lobby4.contains(c)) {
                    lobby4.cancel(c);
                }
            }
        }
    }
}
// Check lobby10 (groups of 5+) for overdue leaders
for (Object obj : new java.util.ArrayList<>(lobby10.getPeds())) {
    Customer c = (Customer) obj;
    if (c.getGroup() == null || c.getGroup().getLeader() == c) {
        if (c.entryTime >= 0 && (time(MINUTE) - c.entryTime) > c.balkingThreshold) {
            balkCount++;
            // Cancel entire group - routes through ccl port -> balkSink1
            if (c.getGroup() != null) {
                java.util.ArrayList<Agent> members = new java.util.ArrayList<>();
                for (Agent a : c.getGroup()) members.add(a);
                for (Agent a : members) {
                    Customer member = (Customer) a;
                    if (lobby10.contains(member)) {
                        lobby10.cancel(member);
                    }
                }
            } else {
                if (lobby10.contains(c)) {
                    lobby10.cancel(c);
                }
            }
        }
    }
}
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775755434933</Id>
					<Name><![CDATA[assignTableAndFree]]></Name>
					<X>240</X><Y>1245</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Customer]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[size]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[RectangularNode table = null;

if (size <= 4) {
    if (!availableFourSeaters.isEmpty()) {
        table = availableFourSeaters.remove(0);
    }
} else {
    if (!availableTenSeaters.isEmpty()) {
        table = availableTenSeaters.remove(0);
    }
}

if (table != null) {
    executeTableAssignment(ped, table);
    PedWait lobby = (size <= 4) ? lobby4 : lobby10;
    if (ped.getGroup() != null) {
        for (Agent a : ped.getGroup()) {
            lobby.free(a);
        }
    } else {
        lobby.free(ped);
    }
} else {
    traceln("Waiting for table to become available for: " + ped);
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1775756460913</Id>
					<Name><![CDATA[executeTableAssignment]]></Name>
					<X>240</X><Y>1210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[leader]]></Name>
						<Type><![CDATA[Customer]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[table]]></Name>
						<Type><![CDATA[RectangularNode]]></Type>
					</Parameter>
					<Body><![CDATA[if (table == null || leader == null) return;

// Assign to leader
leader.assignedTable = table;

// Assign to all group members immediately
if (leader.getGroup() != null) {
    for (Agent a : leader.getGroup()) {
        Customer member = (Customer) a;
        member.assignedTable = table;
        // Sync group size for assembly later 
        member.groupSize = leader.getGroup().size();
    }
} else {
    leader.groupSize = 1;
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1775756461000</Id>
					<Name><![CDATA[tryReserveTable]]></Name>
					<X>240</X><Y>1175</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Customer]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[isTenSeaterRequest]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[// 1. If already assigned (e.g. group member inherits leader's choice), succeed immediately
if (ped.assignedTable != null) return true;

// 2. Select collection based on request type
ArrayList<RectangularNode> pool = isTenSeaterRequest ? availableTenSeaters : availableFourSeaters;

// 3. Atomically check and remove
if (!pool.isEmpty()) {
    RectangularNode table = pool.remove(0);
    executeTableAssignment(ped, table);
    return true;
}

return false;]]></Body>
				</Function>
			</Functions>
