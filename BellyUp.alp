					<Name><![CDATA[returnTableSink]]></Name>
					<X>660</X><Y>1440</Y>
					<Label><X>-10</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Sink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Sink]]></ClassName>
							<ItemName><![CDATA[1412336242929]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (dirtyTables.size() > 0) {
    RectangularNode cleanTable = dirtyTables.remove(0);
    boolean isLarge = cleanTable.getName().contains("table10seaters");
    PedWait lobby = isLarge ? lobby10 : lobby4;
    
    if (lobby.size() > 0) {
        Customer leader = (Customer) lobby.getPeds().iterator().next();
        
        // Pass 1: Immediate Assignment to all
        executeTableAssignment(leader, cleanTable);
        
        // Pass 2: Release from lobby
        if (leader.getGroup() != null) {
            for (Agent a : leader.getGroup()) {
                lobby.free(a);
            }
        } else {
            lobby.free(leader);
        }
    } else {
        // Return to pool if no one is waiting
        if (isLarge) availableTenSeaters.add(cleanTable);
        else availableFourSeaters.add(cleanTable);
    }
}
]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destroyEntity]]></Name>
						</Parameter>
